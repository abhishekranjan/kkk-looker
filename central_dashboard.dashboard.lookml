# ============================================================================
# FILE: central_dashboard.dashboard.lookml
# Section B - National Implementation Dashboard (CBC, unrestricted)
# Karmayogi Kartavya Karyakram
#
# Requires Looker 26.4+ (dashboard tabs; Looker allows at most 5). Tabs:
#   1 National Overview      - Box 1 + every panel of the HTML Implementation tab
#   2 SMT · One-Day · SLT    - one band per programme (SMT, then One-Day, then SLT)
#   3 State Drill-down       - Boxes 3, 4, 5 (+ record, districts, assessment)
#   4 SMT Targets & Roadmap  - CBC Monthly SMT Targets + HTML Target Tracker, then Roadmap 2027
#   5 Assessments & Export   - Box 9 and Box 10 (kept separate), then Box 11 full export
#
# Maps use Static Map (Regions): only the official TopoJSON is drawn, with no
# third-party basemap, so no disputed-border lines appear.
# GENERATED by gen_dashboard.py - edit the generator, not this file.
# ============================================================================

- dashboard: central_dashboard
  title: National Implementation Dashboard
  description: Capacity Building Commission - Karmayogi Kartavya Karyakram. Every State and UT, no access limits.
  layout: newspaper
  refresh: 1 hour
  crossfilter_enabled: true
  embed_style:
    background_color: '#FAF8F3'
    tile_background_color: '#FFFFFF'
    tile_text_color: '#1C2430'
    title_color: '#12233B'
    show_title: true
    text_tile_text_color: '#707A88'
  tabs:
  - name: overview
    label: National Overview
  - name: programmes
    label: SMT · One-Day · SLT
  - name: state_drill
    label: State Drill-down
  - name: targets_roadmap
    label: SMT Targets & Roadmap
  - name: assessment_export
    label: Assessments & Export
  filters:
  - name: zone
    title: Zone
    type: field_filter
    default_value: ''
    allow_multiple_values: true
    required: false
    ui_config:
      type: checkboxes
      display: popover
    model: central_dashboard
    explore: state_snapshot
    field: dim_state.zone
  - name: state
    title: State / UT
    type: field_filter
    default_value: ''
    allow_multiple_values: true
    required: false
    ui_config:
      type: tag_list
      display: popover
    model: central_dashboard
    explore: state_snapshot
    listens_to_filters: [zone]
    field: dim_state.state_name
  - name: drill_state
    title: Drill-down State
    type: field_filter
    default_value: Odisha
    allow_multiple_values: false
    required: false
    ui_config:
      type: dropdown_menu
      display: inline
    model: central_dashboard
    explore: state_snapshot
    field: dim_state.state_name
  - name: target_month
    title: Target Month
    type: field_filter
    default_value: Aug'26
    allow_multiple_values: false
    required: false
    ui_config:
      type: dropdown_menu
      display: inline
    model: central_dashboard
    explore: target_tracker
    field: target_tracker.month_label
  - name: batch_date
    title: Batch Date
    type: field_filter
    default_value: ''
    allow_multiple_values: true
    required: false
    ui_config:
      type: advanced
      display: popover
    model: central_dashboard
    explore: fact_batch_activity
    field: dim_date.date
  elements:

  # ======================================================================
  # TAB 1 - NATIONAL OVERVIEW (Box 1, and every panel of the HTML 'Implementation' tab)
  # ======================================================================
  - name: ov_header
    type: text
    body_text: <b>Programme Implementation Status</b> &mdash; state-wise rollout of the Karmayogi Kartavya Karyakram across every State and Union Territory. Status colour comes only from Table 1 of the programme Sheet; the counts beside it come from Table 2 and are never used to infer status. Figures match the client HTML (Sheet snapshot, 21 Aug 2026).
    tab_name: overview
    row: 0
    col: 0
    width: 24
    height: 2
  - name: ov_states_started
    title: States/UTs with implementation started
    model: central_dashboard
    explore: state_snapshot
    type: single_value
    fields: [fact_state_snapshot.states_started, fact_state_snapshot.state_count]
    show_single_value_title: true
    single_value_title: States/UTs with implementation started
    custom_color_enabled: true
    custom_color: '#12233B'
    value_format: '0'
    show_comparison: true
    comparison_type: progress
    comparison_reverse_colors: false
    show_comparison_label: true
    comparison_label: of all States/UTs
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 2
    col: 0
    width: 6
    height: 3
  - name: ov_smt_trained
    title: State Master Trainers trained
    model: central_dashboard
    explore: state_snapshot
    type: single_value
    fields: [fact_state_snapshot.smt_trained, fact_state_snapshot.smt_batches]
    show_single_value_title: true
    single_value_title: State Master Trainers trained
    custom_color_enabled: true
    custom_color: '#AD7C25'
    value_format: '#,##0'
    show_comparison: true
    comparison_type: value
    comparison_reverse_colors: false
    show_comparison_label: true
    comparison_label: SMT batches (2-day)
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 2
    col: 6
    width: 6
    height: 3
  - name: ov_one_day_trained
    title: One-Day participants trained
    model: central_dashboard
    explore: state_snapshot
    type: single_value
    fields: [fact_state_snapshot.one_day_trained, fact_state_snapshot.one_day_batches]
    show_single_value_title: true
    single_value_title: One-Day participants trained
    custom_color_enabled: true
    custom_color: '#2F7D57'
    value_format: '#,##0'
    show_comparison: true
    comparison_type: value
    comparison_reverse_colors: false
    show_comparison_label: true
    comparison_label: One-Day batches
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 2
    col: 12
    width: 6
    height: 3
  - name: ov_not_started
    title: States/UTs yet to start
    model: central_dashboard
    explore: state_snapshot
    type: single_value
    fields: [fact_state_snapshot.states_not_started]
    show_single_value_title: true
    single_value_title: States/UTs yet to start
    custom_color_enabled: true
    custom_color: '#B04435'
    value_format: '0'
    show_comparison: false
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 2
    col: 18
    width: 6
    height: 3
  - name: ov_programme_target
    title: Overall programme target
    model: central_dashboard
    explore: state_snapshot
    type: single_value
    fields: [fact_state_snapshot.programme_target]
    show_single_value_title: true
    single_value_title: Overall programme target
    custom_color_enabled: true
    custom_color: '#12233B'
    value_format: '#,##0'
    show_comparison: false
    note_state: expanded
    note_display: below
    note_text: 1,30,00,000 officials (1.3 crore), per the programme roadmap.
    tab_name: overview
    row: 5
    col: 0
    width: 6
    height: 5
  - name: ov_target_gauge
    title: Target Tracker - progress against 1.3 crore (%)
    model: central_dashboard
    explore: state_snapshot
    type: looker_column
    fields: [fact_state_snapshot.all_india, fact_state_snapshot.pct_of_programme_target_points]
    sorts: [fact_state_snapshot.all_india]
    limit: 1
    show_value_labels: true
    x_axis_gridlines: false
    y_axis_gridlines: true
    legend_position: center
    show_view_names: false
    series_colors:
      fact_state_snapshot.pct_of_programme_target_points: '#D97B34'
    advanced_vis_config: "{\n  chart: {type: 'solidgauge'},\n  pane: {startAngle: -90, endAngle: 90, background: [{innerRadius: '60%', outerRadius: '100%', shape: 'arc', backgroundColor: '#E9E5D8', borderWidth: 0}]},\n  yAxis: [{min: 0, max: 100, tickAmount: 5, lineWidth: 0, labels: {format: '{value}%'}}],\n  plotOptions: {solidgauge: {innerRadius: '60%', dataLabels: {y: -25, borderWidth: 0, format: '{y:.3f}%'}}},\n  series: [{color: '#D97B34'}],\n  legend: {enabled: false}\n}"
    note_state: collapsed
    note_display: hover
    note_text: One-Day participants trained as a share of the 1.3 crore programme target, nationwide.
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 5
    col: 6
    width: 9
    height: 5
  - name: ov_target_progress
    title: Officials reached against 1.3 crore
    model: central_dashboard
    explore: state_snapshot
    type: single_value
    fields: [fact_state_snapshot.one_day_trained, fact_state_snapshot.programme_target]
    show_single_value_title: true
    single_value_title: Officials reached against 1.3 crore
    custom_color_enabled: true
    custom_color: '#D97B34'
    value_format: '#,##0'
    show_comparison: true
    comparison_type: progress_percentage
    comparison_reverse_colors: false
    show_comparison_label: true
    comparison_label: of 1,30,00,000
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 5
    col: 15
    width: 9
    height: 5
  - name: ov_status_map
    title: India at a Glance - Implementation Status
    model: central_dashboard
    explore: state_snapshot
    type: looker_geo_choropleth
    fields: [dim_state.state_name, fact_state_snapshot.stage, fact_state_snapshot.smt_value, fact_state_snapshot.one_day_value, fact_state_snapshot.stage_code]
    sorts: [dim_state.state_name]
    limit: 500
    map: auto
    quantize_colors: true
    colors: ['#B04435', '#AD7C25', '#2F7D57']
    empty_color: '#F2EFE6'
    outer_border_color: '#5B6573'
    inner_border_color: '#FFFFFF'
    outer_border_width: 1.2
    inner_border_width: 0.8
    show_view_names: false
    note_state: expanded
    note_display: below
    note_text: 'Green: One-Day Completed. Amber: SMT Completed (One-Day pending). Red: Not Completed. Official boundaries, no basemap. The map always shows all 36 States/UTs so colours stay comparable. Hover for counts; click a State/UT to open it in the State Drill-down tab.'
    tab_name: overview
    row: 10
    col: 0
    width: 16
    height: 20
  - name: ov_status_legend
    title: Legend - States/UTs by status
    model: central_dashboard
    explore: state_snapshot
    type: looker_grid
    fields: [fact_state_snapshot.stage, fact_state_snapshot.state_count, fact_state_snapshot.smt_trained, fact_state_snapshot.one_day_trained]
    sorts: [fact_state_snapshot.stage desc]
    limit: 500
    total: true
    show_view_names: false
    show_row_numbers: false
    table_theme: white
    limit_displayed_rows: false
    enable_conditional_formatting: false
    header_text_alignment: left
    header_font_size: '12'
    rows_font_size: '12'
    show_totals: true
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 10
    col: 16
    width: 8
    height: 6
  - name: ov_zone_strip
    title: Regional Implementation - North · South · East · West
    model: central_dashboard
    explore: state_snapshot
    type: looker_grid
    fields: [dim_state.zone, fact_state_snapshot.state_count, fact_state_snapshot.states_started, fact_state_snapshot.states_one_day, fact_state_snapshot.states_smt_only, fact_state_snapshot.states_not_started, fact_state_snapshot.smt_trained, fact_state_snapshot.one_day_trained]
    sorts: [dim_state.zone]
    limit: 500
    total: true
    show_view_names: false
    show_row_numbers: false
    table_theme: white
    limit_displayed_rows: false
    enable_conditional_formatting: false
    header_text_alignment: left
    header_font_size: '12'
    rows_font_size: '12'
    show_totals: true
    series_labels:
      fact_state_snapshot.state_count: States/UTs
      fact_state_snapshot.states_started: Started
      fact_state_snapshot.states_one_day: Green
      fact_state_snapshot.states_smt_only: Amber
      fact_state_snapshot.states_not_started: Red
      fact_state_snapshot.smt_trained: SMT
      fact_state_snapshot.one_day_trained: 1-Day
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 16
    col: 16
    width: 8
    height: 7
  - name: ov_small_states
    title: Smaller States & Union Territories
    model: central_dashboard
    explore: state_snapshot
    type: looker_grid
    fields: [dim_state.state_name, fact_state_snapshot.stage, fact_state_snapshot.smt_value, fact_state_snapshot.one_day_value]
    filters:
      fact_state_snapshot.is_small_state: 'Yes'
    sorts: [dim_state.state_name]
    limit: 500
    show_view_names: false
    show_row_numbers: false
    table_theme: white
    limit_displayed_rows: false
    enable_conditional_formatting: false
    header_text_alignment: left
    header_font_size: '12'
    rows_font_size: '12'
    note_state: collapsed
    note_display: hover
    note_text: Listed separately because they are too small to click reliably on the map.
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 23
    col: 16
    width: 8
    height: 7
  - name: ov_started_list
    title: Started
    model: central_dashboard
    explore: state_snapshot
    type: looker_grid
    fields: [dim_state.state_name, dim_state.zone, fact_state_snapshot.stage, fact_state_snapshot.smt_value, fact_state_snapshot.one_day_value]
    filters:
      fact_state_snapshot.has_started: 'Yes'
    sorts: [fact_state_snapshot.one_day_value desc, fact_state_snapshot.smt_value desc]
    limit: 500
    show_view_names: false
    show_row_numbers: true
    table_theme: white
    limit_displayed_rows: false
    enable_conditional_formatting: false
    header_text_alignment: left
    header_font_size: '12'
    rows_font_size: '12'
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 30
    col: 0
    width: 12
    height: 10
  - name: ov_not_started_list
    title: Yet to Start
    model: central_dashboard
    explore: state_snapshot
    type: looker_grid
    fields: [dim_state.state_name, dim_state.zone, fact_state_snapshot.stage]
    filters:
      fact_state_snapshot.has_started: 'No'
    sorts: [dim_state.state_name]
    limit: 500
    show_view_names: false
    show_row_numbers: true
    table_theme: white
    limit_displayed_rows: false
    enable_conditional_formatting: false
    header_text_alignment: left
    header_font_size: '12'
    rows_font_size: '12'
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 30
    col: 12
    width: 12
    height: 10
  - name: ov_data_quality
    title: Data quality notes - Table 1 / Table 2 mismatches
    model: central_dashboard
    explore: state_snapshot
    type: looker_grid
    fields: [dim_state.state_name, fact_state_snapshot.smt_status, fact_state_snapshot.one_day_status, fact_state_snapshot.smt_value, fact_state_snapshot.one_day_value, fact_state_snapshot.mismatch_note]
    filters:
      fact_state_snapshot.has_mismatch: 'Yes'
    sorts: [dim_state.state_name]
    limit: 500
    show_view_names: false
    show_row_numbers: true
    table_theme: white
    limit_displayed_rows: false
    enable_conditional_formatting: false
    header_text_alignment: left
    header_font_size: '12'
    rows_font_size: '12'
    note_state: collapsed
    note_display: hover
    note_text: Empty means Table 1 status and Table 2 counts agree for every State/UT. Mismatches are reported, never silently reconciled.
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 40
    col: 0
    width: 24
    height: 4
  - name: ov_journey_header
    type: text
    body_text: <b>Implementation Journey</b>
    tab_name: overview
    row: 44
    col: 0
    width: 24
    height: 1
  - name: ov_journey_1
    title: States/UTs in the SMT ecosystem or beyond
    model: central_dashboard
