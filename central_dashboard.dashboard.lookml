  - name: ov_certification_trend
    title: Certification Trend - split by programme (batches by month)
    model: central_dashboard
    explore: fact_batch_activity
    type: looker_line
    fields: [dim_date.month_name, fact_batch_activity.smt_batches, fact_batch_activity.one_day_batches]
    sorts: [dim_date.month_name]
    limit: 500
    show_value_labels: false
    x_axis_gridlines: false
    y_axis_gridlines: true
    legend_position: center
    show_view_names: false
    series_colors:
      fact_batch_activity.smt_batches: '#1D3557'
      fact_batch_activity.one_day_batches: '#D97B34'
    series_labels:
      fact_batch_activity.smt_batches: State Master Trainer batches (2-day)
      fact_batch_activity.one_day_batches: 1-Day Participant batches
    point_style: circle
    interpolation: linear
    note_state: collapsed
    note_display: hover
    note_text: Two lines, month-wise. Batch dates are partly demo where the Sheet had none; totals reconcile to the Sheet.
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
      batch_date: dim_date.date
    tab_name: overview
    row: 48
    col: 0
    width: 24
    height: 8
  - name: ov_top10_one_day
