  - name: ov_cluster_smt
    title: Cluster Comparison - State Master Trainers
    model: central_dashboard
    explore: state_snapshot
    type: looker_column
    fields: [dim_state.zone, fact_state_snapshot.smt_trained]
    sorts: [dim_state.zone]
    show_value_labels: true
    x_axis_gridlines: false
    y_axis_gridlines: true
    legend_position: center
    show_view_names: false
    series_colors:
      fact_state_snapshot.smt_trained: '#AD7C25'
    hide_legend: true
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: overview
    row: 77
    col: 0
    width: 12
    height: 7
  - name: ov_cluster_one_day
    title: Cluster Comparison - One-Day Participants
