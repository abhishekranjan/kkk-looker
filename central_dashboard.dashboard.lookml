    filters:
      fact_monthly_target.month_id: 2026-08,2026-09,2026-10,2026-11,2026-12,2027-01,2027-02
    sorts: [fact_monthly_target.month_label]
    show_value_labels: true
    x_axis_gridlines: false
    y_axis_gridlines: true
    legend_position: center
    show_view_names: false
    series_colors:
      fact_monthly_target.smt_target: '#1D3557'
      fact_monthly_target.smt_target_headcount: '#D97B34'
    y_axes:
    - label: Batches
      orientation: left
      series:
      - id: fact_monthly_target.smt_target
    - label: SMTs (headcount)
      orientation: right
      series:
      - id: fact_monthly_target.smt_target_headcount
    note_state: collapsed
    note_display: hover
    note_text: 'Headcount: Aug and Sep as written in the Sheet; Oct-Feb derived as batches x 35.'
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: targets_roadmap
    row: 46
    col: 0
    width: 24
    height: 7

