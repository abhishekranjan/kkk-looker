    height: 11
  - name: tg_month_by_month
    title: Month-by-month SMT batch targets (Aug'26 to Feb'27)
    model: central_dashboard
    explore: fact_monthly_target
    type: looker_grid
    fields: [dim_state.state_name, fact_state_snapshot.frontline_value, fact_state_snapshot.smt_till_aug_value, fact_monthly_target.month_label, fact_monthly_target.smt_target]
    pivots: [fact_monthly_target.month_label]
    filters:
      fact_monthly_target.month_id: 2026-08,2026-09,2026-10,2026-11,2026-12,2027-01,2027-02
    sorts: [fact_monthly_target.month_label, fact_state_snapshot.frontline_value desc]
    limit: 500
    total: true
    show_view_names: false
    show_row_numbers: true
    table_theme: white
    limit_displayed_rows: false
    enable_conditional_formatting: false
    header_text_alignment: left
    header_font_size: '12'
    rows_font_size: '12'
    show_totals: true
    series_labels:
      dim_state.state_name: State
      fact_state_snapshot.frontline_value: Frontline target
      fact_state_snapshot.smt_till_aug_value: SMT Trained till Aug'26 (actual)
      fact_monthly_target.smt_target: Batches
    row_total: right
    note_state: collapsed
    note_display: hover
    note_text: Batch targets exactly as the Sheet names them. The Sheet continues through Feb'27.
    listen:
      zone: dim_state.zone
      state: dim_state.state_name
    tab_name: targets_roadmap
    row: 34
    col: 0
    width: 24
    height: 12
